# ======= Afion ERP — Backend environment (DUMMY VALUES — replace before deploy) =======
NODE_ENV=development
PORT=5000

# MongoDB — replace with your Atlas/production URI
MONGODB_URI=mongodb://127.0.0.1:27017/afion_erp

# JWT — replace both secrets with long random strings in production
JWT_ACCESS_SECRET=dummy-access-secret-change-me-7f4k2m9x
JWT_REFRESH_SECRET=dummy-refresh-secret-change-me-p3q8w1z6
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS — frontend origin(s), comma separated
CORS_ORIGINS=http://localhost:5174,http://192.168.1.21:5173

# Seed admin (used by `npm run seed`)
SEED_ADMIN_UID=vikram
SEED_ADMIN_PASSWORD=Afion@123

# Production: serve the built frontend (frontend/dist) from this server on the same origin
SERVE_FRONTEND=false
